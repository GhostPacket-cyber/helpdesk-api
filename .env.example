# Copie este arquivo para .env e ajuste os valores.
# O .env nunca deve ir para o Git.

# Aplicação
NODE_ENV=development
PORT=3000

# PostgreSQL (usadas pelo docker-compose.yml para criar o banco)
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=helpdesk
POSTGRES_PORT=5432

# Senha dos usuários fictícios criados por `npm run db:seed` (mínimo 8 caracteres)
SEED_USER_PASSWORD=troque_esta_senha

# URL usada pela aplicação e pelo Prisma: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Usuário, senha, porta e banco devem ser os mesmos definidos acima.
DATABASE_URL="postgresql://helpdesk:troque_esta_senha@localhost:5432/helpdesk?schema=public"
